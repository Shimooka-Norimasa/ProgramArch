@page "/"
@inherits FluxorComponent
@inject IState<InventoryState> State
@inject IDispatcher Dispatcher

<PageTitle>在庫管理（Flux）</PageTitle>

@if (State.Value.IsLoading)
{
    <p>読み込み中...</p>
}
else
{
    <ProductTable />
    <StockOperationPanel />
}

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();

        // まだ読み込んでいなければ、読み込みを依頼する Action を出す
        if (State.Value.Products.IsEmpty)
        {
            Dispatcher.Dispatch(new LoadProductsAction());
        }
    }
}
