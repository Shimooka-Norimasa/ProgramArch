<Window x:Class="Inventory.Mvvm.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="在庫管理（MVVM）" Width="720" Height="400">

    <!-- View: 見た目だけを宣言する。{Binding ...} で ViewModel のプロパティやコマンドとつながる -->
    <DockPanel Margin="8">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="数量:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox Width="80" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="入庫" Command="{Binding ReceiveCommand}" Margin="8,0,0,0" Padding="12,2" />
            <Button Content="出庫" Command="{Binding ShipCommand}" Margin="8,0,0,0" Padding="12,2" />
            <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="DarkGreen" />
                        <Style.Triggers>
                            <!-- HasError が true のときだけ赤字にする（見た目の判断は View 側の仕事） -->
                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                <Setter Property="Foreground" Value="Crimson" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <DataGrid ItemsSource="{Binding Products}"
                  SelectedItem="{Binding SelectedProduct}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="商品コード" Binding="{Binding Code, Mode=OneWay}" />
                <DataGridTextColumn Header="商品名" Binding="{Binding Name, Mode=OneWay}" Width="*" />
                <DataGridTextColumn Header="在庫数" Binding="{Binding Stock, Mode=OneWay}" />
                <DataGridTextColumn Header="発注点" Binding="{Binding ReorderPoint, Mode=OneWay}" />
                <DataGridTextColumn Header="状態" Binding="{Binding Status, Mode=OneWay}" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
